{
  "type": "client",
  "name": "draw_annotation",
  "description": "Change a grounded region to an arrow, circle, point, label or highlight. Never invent coordinates or region identifiers.",
  "expects_response": true,
  "response_timeout_secs": 60,
  "parameters": {
    "type": "object",
    "properties": {
      "snapshotId": {
        "type": "string",
        "description": "Exact snapshotId returned by analysis."
      },
      "regionId": {
        "type": "string",
        "description": "Exact regionId returned by analysis."
      },
      "shape": {
        "type": "string",
        "description": "One of highlight, arrow, circle, point, label.",
        "enum": [
          "highlight",
          "arrow",
          "circle",
          "point",
          "label"
        ]
      }
    },
    "required": [
      "snapshotId",
      "regionId",
      "shape"
    ]
  }
}

{
  "name": "yoteach",
  "version": "0.1.0",
  "private": true,
  "description": "A local learning workspace and floating desktop companion.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "tsc --noEmit",
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "format": "prettier --write src electron shared scripts tests *.ts",
    "format:check": "prettier --check src electron shared scripts tests *.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.3.2",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

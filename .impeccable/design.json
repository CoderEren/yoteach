  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Implemented primary action; hover, disabled, and keyboard focus are preserved.",
      "html": "<button class=\"ds-button-primary\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New course</button>",
      "css": ".ds-button-primary{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:12px;font-weight:600;line-height:1.3;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:39px;padding:11px 15px;border-radius:10px;cursor:pointer;transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;background:#6b5cdb;color:#fff;border:1px solid #6b5cdb;box-shadow:0 3px 8px #7668f61c;}.ds-button-primary:hover:not(:disabled){background:#6859e4;}.ds-button-primary:disabled{opacity:.48;cursor:not-allowed;}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#7668f6);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;animation:none;}}"
    },

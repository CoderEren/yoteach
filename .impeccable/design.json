      "css": ".ds-field-label{display:flex;flex-direction:column;gap:10px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:12px;font-weight:550;color:var(--text,#172034);}.ds-field{width:100%;min-width:0;border:1px solid var(--line,#e1e6ef);border-radius:9px;background:var(--bg,#f6f8fc);color:var(--text,#172034);padding:12px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;font-weight:400;line-height:1.6;caret-color:var(--iris,#5f4fc4);}.ds-field::placeholder{color:var(--muted,#657188);}.ds-field:focus-visible{outline:3px solid var(--focus,#7668f6);outline-offset:3px;}"

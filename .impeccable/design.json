      "html": "<nav aria-label=\"Workspace navigation\"><button class=\"ds-nav-selected\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z\"/></svg>Workspace</button></nav>",
      "css": ".ds-nav-selected{display:flex;align-items:center;gap:11px;min-height:42px;width:100%;padding:10px 12px;text-align:left;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;font-weight:550;border:0;border-radius:10px;color:var(--iris,#5f4fc4);background:var(--iris-soft,#edeafd);cursor:pointer;transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;}.ds-nav-selected:hover{color:var(--iris,#5f4fc4);background:var(--iris-soft,#edeafd);}.ds-nav-selected:focus-visible{outline:3px solid var(--focus,#7668f6);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-selected{transition:none;animation:none;}}"

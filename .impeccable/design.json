      "css": ".ds-state-group{display:flex;flex-wrap:wrap;gap:5px;}.ds-state-chip{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:9px;padding:6px 8px;border:1px solid var(--line,#e1e6ef);border-radius:6px;background:var(--solid,#fff);color:var(--text,#172034);min-height:26px;cursor:pointer;transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;}.ds-state-active{border-color:var(--iris,#5f4fc4);color:var(--iris,#5f4fc4);background:var(--iris-soft,#edeafd);}.ds-state-chip:focus-visible{outline:3px solid var(--focus,#7668f6);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-state-chip{transition:none;animation:none;}}"
    },
    {
      "name": "Course Card",
      "kind": "card",
      "refersTo": "course-card",
      "description": "A local course with real document/topic counts; values here are explicitly sample content.",
      "html": "<button class=\"ds-course-card\"><span class=\"ds-course-top\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></span><span class=\"ds-course-title\">Biochemistry · Sample</span><span class=\"ds-course-meta\">1 document · 5 topics</span><span class=\"ds-course-footer\">Open your roadmap<span class=\"ds-course-dot\"></span></span></button>",
      "css": ".ds-course-card{display:block;text-align:left;min-width:0;width:260px;max-width:100%;padding:20px 19px 0;border:1px solid var(--glass-line,rgba(255,255,255,.94));border-radius:16px;background:linear-gradient(160deg,var(--course-fill,#f0edfb),var(--panel,rgba(255,255,255,.72)));box-shadow:0 5px 16px rgba(40,50,80,.025);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;color:var(--text,#172034);cursor:pointer;transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;}.ds-course-card:hover{transform:translateY(-3px);box-shadow:0 9px 18px rgba(40,50,80,.08);border-color:color-mix(in srgb,var(--course-ink,#7462d8) 30%,var(--line,#e1e6ef));}.ds-course-top{display:flex;justify-content:space-between;align-items:center;color:var(--course-ink,#7462d8);margin-bottom:23px;}.ds-course-top svg:last-child{opacity:.65;}.ds-course-title{display:block;font-size:17px;font-weight:600;letter-spacing:-.3px;overflow-wrap:anywhere;}.ds-course-meta{display:block;font-size:10px;line-height:1.6;color:var(--muted,#657188);margin-top:8px;}.ds-course-footer{display:flex;align-items:center;justify-content:space-between;border-top:1px solid color-mix(in srgb,var(--course-ink,#7462d8) 12%,transparent);padding:13px 0;margin-top:18px;font-size:10px;color:var(--course-ink,#7462d8);}.ds-course-dot{width:5px;height:5px;border-radius:50%;background:var(--course-ink,#7462d8);}.ds-course-card:focus-visible{outline:3px solid var(--focus,#7668f6);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-course-card{transition:none;animation:none;}}"
    }

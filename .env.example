# Copy to .env, fill values locally, then restart Yoteach.
# Main process only. Never prefix private keys with VITE_. Never commit .env.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ANTHROPIC_API_KEY=
# fal generative visual analogies (main process only). Keys: https://fal.ai/dashboard/keys
FAL_KEY=
# Optional: text-to-image model (default fal-ai/flux/schnell, a fraction of a cent per image).
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Optional: enables captioned explanatory videos; generation can take several minutes.
# Any fal text-to-video model taking {prompt} and returning {video} works; leave empty to hide.
# FAL_VIDEO_MODEL=fal-ai/kling-video/v3/pro/text-to-video
# Kling v3 gets three 5-second shots; LTX 2.3 fast remains supported at 12 seconds.
# Claude vision with structured JSON output (Messages API).
VISION_MODEL=claude-sonnet-5-5
# Optional: faster model for pointer descriptions, topic filing and slide preparation.
# Screen localization uses VISION_MODEL for accuracy.
# QUICK_VISION_MODEL=claude-haiku-5-5
# Optional isolated local workspace for development:
# YOTEACH_DATA_DIR=/absolute/path/to/test-data

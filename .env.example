# Copy to .env, fill values locally, then restart Yoteach.
# Main process only. Never prefix private keys with VITE_. Never commit .env.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ANTHROPIC_API_KEY=
# fal generative visual analogies (main process only). Keys: https://fal.ai/dashboard/keys
FAL_KEY=
# Optional: text-to-image model (default fal-ai/flux/schnell, a fraction of a cent per image).
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Optional: enables Short clip. Any fal text-to-video model taking {prompt} and returning {video}.
# FAL_VIDEO_MODEL=
# Claude vision with structured JSON output (Messages API).
VISION_MODEL=claude-sonnet-4-6
# Optional isolated local workspace for development:
# YOTEACH_DATA_DIR=/absolute/path/to/test-data
